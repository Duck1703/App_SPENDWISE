# Spendwise LAN backend - environment template (M21).
# Copy to spendwise-lan.env (gitignored) and fill real values. Never commit
# the real file; never paste values into chat or docs.

# LAN bind address of this PC (ipconfig -> Wi-Fi IPv4). Bind the app to this
# NIC only - narrower than 0.0.0.0.
SPENDWISE_LAN_HOST=192.168.x.x

# App endpoints (8080 is already occupied by another Docker service).
SPENDWISE_HTTP_PORT=8081
SPENDWISE_HTTPS_PORT=8443

# Database - the existing spendwise-m10-db container publishes 55432.
# Point SPENDWISE_DB_NAME at a dedicated DB; the smoke DB is spendwise_m21.
SPENDWISE_DB_URL=jdbc:postgresql://localhost:55432/spendwise_m21
SPENDWISE_DB_USERNAME=spendwise_m21
SPENDWISE_DB_PASSWORD=

# JWT - generate once: openssl rand -base64 48. Keep it stable across
# restarts or every restart invalidates all sessions.
SPENDWISE_JWT_SECRET=

# HTTPS (Level B) - generated artifacts in ~/.spendwise-lan-tls/.
# server-keystore.p12 + its password (see scripts/lan/generate-lan-tls.sh).
SPENDWISE_TLS_KEYSTORE=
SPENDWISE_TLS_KEYSTORE_PASSWORD=
SPENDWISE_TLS_KEY_ALIAS=spendwise-lan

# Release APK signing (Human-owned identity - env only, never committed).
SPENDWISE_RELEASE_KEYSTORE_PATH=
SPENDWISE_RELEASE_KEY_ALIAS=
SPENDWISE_RELEASE_STORE_PASSWORD=
SPENDWISE_RELEASE_KEY_PASSWORD=
